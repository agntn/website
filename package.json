{
  "name": "website",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev --extends docus",
    "build": "NUXT_SITE_URL=https://agntn.dev nuxt build --extends docus",
    "generate": "NUXT_SITE_URL=https://agntn.dev nuxt generate --extends docus",
    "preview": "nuxt preview --extends docus",
    "libraries": "node scripts/generate-libraries.mjs",
    "deploy": "pnpm build && wrangler deploy"
  },
  "dependencies": {
    "better-sqlite3": "12.11.1",
    "docus": "5.15.0",
    "nuxt": "4.6.4"
  },
  "packageManager": "pnpm@11.3.0",
  "devDependencies": {
    "@iconify-json/lucide": "1.2.139",
    "@iconify-json/simple-icons": "1.2.98",
    "@iconify-json/vscode-icons": "1.2.84",
    "wrangler": "4.160.0"
  }
}
