{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agntn-website",
  "account_id": "6ef8d3cbe19975e93d994f25228488e7",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "NUXT_SITE_URL": "https://agntn.dev"
  },
  "workers_dev": true,
  "preview_urls": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "agntn-website",
      "database_id": "758c8c66-9cd4-4c5f-aa9f-a2cdd502477b"
    }
  ],
  "routes": [{ "pattern": "agntn.dev", "custom_domain": true }],
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  }
}
